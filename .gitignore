.venv/
__pycache__/

# Local secrets. `nlq._api_key()` reads st.secrets before the environment, so a
# local ANTHROPIC_API_KEY normally lives here -- and this repo is public, so an
# unignored secrets.toml would publish the key on the next `git add -A`.
# (`.streamlit/config.toml` is deliberately absent for a separate reason: setting
# a Streamlit `base` theme would fix one palette's chrome and break the other's.)
.streamlit/secrets.toml
.env

# Build artifacts. app.py rebuilds the database from the committed
# data/prices.csv.gz + data/symbols.csv on first run, so a fresh deploy needs
# neither of these in version control.
data/sp500.db
data/prices.csv

# Per-symbol fetch cache: 33MB that only exists to make a rate-limited
# fetch_data.py run resumable. Regenerated on demand.
data/cache/
data/*.db.building

# The same idea for the intelligence universe, and much larger: ~135MB of
# per-symbol price CSVs plus the raw SEC companyfacts extracts, kept only so a
# rate-limited fetch_intel.py run resumes instead of restarting.
#
# The three ARTIFACTS it produces are committed, because a fresh deploy rebuilds
# the database from them and cannot run a 15-minute fetch on first request:
#   data/intel_universe.csv       (the ranked universe + SIC sectors)
#   data/intel_prices.csv.gz      (5y daily bars)
#   data/intel_fundamentals.csv.gz(SEC XBRL figures, as filed)
data/intel_cache/
